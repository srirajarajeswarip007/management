  #include <stdio.h>
#include <omp.h>

int main() {
    int arr[100];
    int sum = 0;
    int i;

    // Initialize array
    for (i = 0; i < 100; i++) {
        arr[i] = i + 1;
    }

    // Parallel sum
    #pragma omp parallel for reduction(+:sum)
    for (i = 0; i < 100; i++) {
        sum += arr[i];
    }

    printf("Total sum = %d\n", sum);

    return 0;
}

